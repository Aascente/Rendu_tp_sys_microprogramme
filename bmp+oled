/* USER CODE BEGIN 4 */
float BMP280_ReadTemperature(void) {
    uint8_t raw[3];
    HAL_I2C_Mem_Read(&hi2c1, BMP280_ADDR, 0xFA, 1, raw, 3, HAL_MAX_DELAY);
    int32_t adc_T = (int32_t)(((uint32_t)raw[0] << 12) | ((uint32_t)raw[1] << 4) | ((uint32_t)raw[2] >> 4));

    float var1 = (((float)adc_T) / 16384.0f - ((float)bmp280_calib.dig_T1) / 1024.0f) * ((float)bmp280_calib.dig_T2);
    float var2 = ((((float)adc_T) / 131072.0f - ((float)bmp280_calib.dig_T1) / 8192.0f) *
                  (((float)adc_T) / 131072.0f - ((float)bmp280_calib.dig_T1) / 8192.0f)) * ((float)bmp280_calib.dig_T3);

    t_fine = (int32_t)(var1 + var2); // On met à jour t_fine pour la pression
    return (var1 + var2) / 5120.0f;
}

float BMP280_ReadPressure(void) {
    uint8_t raw[3];
    // Lecture des 3 registres de pression (0xF7 à 0xF9)
    HAL_I2C_Mem_Read(&hi2c1, BMP280_ADDR, 0xF7, 1, raw, 3, HAL_MAX_DELAY);
    int32_t adc_P = (int32_t)(((uint32_t)raw[0] << 12) | ((uint32_t)raw[1] << 4) | ((uint32_t)raw[2] >> 4));

    float v1, v2, P;

    // v1 et v2 utilisent t_fine calculé par la température
    v1 = ((float)t_fine / 2.0f) - 64000.0f;
    v2 = v1 * v1 * ((float)bmp280_calib.dig_P6) / 32768.0f;
    v2 = v2 + v1 * ((float)bmp280_calib.dig_P5) * 2.0f;
    v2 = (v2 / 4.0f) + (((float)bmp280_calib.dig_P4) * 65536.0f);

    v1 = (((float)bmp280_calib.dig_P3) * v1 * v1 / 524288.0f + ((float)bmp280_calib.dig_P2) * v1) / 524288.0f;
    v1 = (1.0f + v1 / 32768.0f) * ((float)bmp280_calib.dig_P1);

    if (v1 == 0.0f) return 0; // Sécurité division par zéro

    P = 1048576.0f - (float)adc_P; // <--- LA CORRECTION EST ICI (2^20 au lieu de 2^31)
    P = (P - (v2 / 4096.0f)) * 6250.0f / v1;

    v1 = ((float)bmp280_calib.dig_P9) * P * P / 2147483648.0f;
    v2 = P * ((float)bmp280_calib.dig_P8) / 32768.0f;
    P = P + (v1 + v2 + ((float)bmp280_calib.dig_P7)) / 16.0f;

    return P / 100.0f; // On retourne des hPa
}

