    HAL_I2C_Mem_Write(&hi2c1, OLED_ADDR, 0x00, 1, &cmd, 1, 10);
}

void OLED_Init(void) {
    uint8_t init[] = { 0xAE, 0x20, 0x00, 0xB0, 0xC8, 0x00, 0x10, 0x40, 0x81, 0x7F,
                       0xA1, 0xA6, 0xA8, 0x3F, 0xA4, 0xD3, 0x00, 0xD5, 0xF0,
                       0xD9, 0x22, 0xDA, 0x12, 0xDB, 0x20, 0x8D, 0x14, 0xAF };
    for(int i=0; i<sizeof(init); i++) OLED_SendCmd(init[i]);
}

void OLED_Clear(void) {
    uint8_t zero[128] = {0};
    for(uint8_t i=0; i<8; i++) {
        OLED_SetCursor(0, i);
        HAL_I2C_Mem_Write(&hi2c1, OLED_ADDR, 0x40, 1, zero, 128, 100);
    }
}

void OLED_SetCursor(uint8_t x, uint8_t page) {
    OLED_SendCmd(0xB0 + page);            // Choix de la page (0-7)
    OLED_SendCmd(0x00 + (x & 0x0F));       // Colonne basse
    OLED_SendCmd(0x10 + ((x >> 4) & 0x0F));// Colonne haute
}

void OLED_WriteStr(char* str) {
    while(*str) {
        char c = *str++;
        uint8_t data[6] = {0};
        if(c >= 32 && c <= 126) {
            // On cherche le caractère dans la police (ASCII - 32)
            memcpy(data, font5x7[c-32], 5);
        }
        // Envoi des 5 pixels du caractère + 1 pixel d'espace (le 0 final du tableau data)
        HAL_I2C_Mem_Write(&hi2c1, OLED_ADDR, 0x40, 1, data, 6, 10);
    }
}

