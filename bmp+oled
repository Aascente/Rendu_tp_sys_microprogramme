/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */
  OLED_Init();
  OLED_Clear();

  uint8_t calib[24];

  // On lit les 24 octets de calibration d'un seul coup (de 0x88 à 0x9F)
  HAL_I2C_Mem_Read(&hi2c1, BMP280_ADDR, 0x88, 1, calib, 24, HAL_MAX_DELAY);

  // --- Température ---
  bmp280_calib.dig_T1 = (uint16_t)((calib[1] << 8) | calib[0]);
  bmp280_calib.dig_T2 = (int16_t)((calib[3] << 8) | calib[2]);
  bmp280_calib.dig_T3 = (int16_t)((calib[5] << 8) | calib[4]);

  // --- Pression ---
  bmp280_calib.dig_P1 = (uint16_t)((calib[7] << 8) | calib[6]);
  bmp280_calib.dig_P2 = (int16_t)((calib[9] << 8) | calib[8]);
  bmp280_calib.dig_P3 = (int16_t)((calib[11] << 8) | calib[10]);
  bmp280_calib.dig_P4 = (int16_t)((calib[13] << 8) | calib[12]);
  bmp280_calib.dig_P5 = (int16_t)((calib[15] << 8) | calib[14]);
  bmp280_calib.dig_P6 = (int16_t)((calib[17] << 8) | calib[16]);
  bmp280_calib.dig_P7 = (int16_t)((calib[19] << 8) | calib[18]);
  bmp280_calib.dig_P8 = (int16_t)((calib[21] << 8) | calib[20]);
  bmp280_calib.dig_P9 = (int16_t)((calib[23] << 8) | calib[22]);

  // --- Configuration du capteur (Registre 0xF4) ---
  // 0x27 = Mode Normal, Temp x1, Press x1
  uint8_t config = 0x27;
  HAL_I2C_Mem_Write(&hi2c1, BMP280_ADDR, 0xF4, 1, &config, 1, HAL_MAX_DELAY);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  // toujours commencer par lire la temperature pour eviter pb avec variable t_fine
	      float temperature = BMP280_ReadTemperature();
	      float pression = BMP280_ReadPressure();

	      // Ligne 1 : Titre
	      OLED_SetCursor(20, 0);
	      OLED_WriteStr("STATION METEO");

	      // Ligne 3 : Température
	      OLED_SetCursor(0, 3);
	      sprintf(msg, "TEMP : %.2f C  ", temperature);
	      OLED_WriteStr(msg);

	      // Ligne 5 : Pression
	      OLED_SetCursor(0, 5);
	      sprintf(msg, "PRES : %.1f HPA ", pression);
	      OLED_WriteStr(msg);

	      sprintf(msg, "Temp: %.2f C | Press: %.2f hPa\r\n", temperature, pression);
	      HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

	      HAL_Delay(1000);
  }
  /* USER CODE END 3 */
}

