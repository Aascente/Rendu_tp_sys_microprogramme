void OLED_Clear(void) {
    uint8_t zero[128] = {0};
    for(uint8_t i=0; i<8; i++) {
        OLED_SetCursor(0, i);
        HAL_I2C_Mem_Write(&hi2c1, OLED_ADDR, 0x40, 1, zero, 128, 100);
    }
}

void OLED_SetCursor(uint8_t x, uint8_t page) {
    OLED_SendCmd(0xB0 + page);            // Choix de la page (0-7)
    OLED_SendCmd(0x00 + (x & 0x0F));       // Colonne basse
    OLED_SendCmd(0x10 + ((x >> 4) & 0x0F));// Colonne haute
}

void OLED_WriteStr(char* str) {
    while(*str) {
        char c = *str++;
        uint8_t data[6] = {0};
        if(c >= 32 && c <= 126) {
            // On cherche le caractère dans la police (ASCII - 32)
            memcpy(data, font5x7[c-32], 5);
        }
        // Envoi des 5 pixels du caractère + 1 pixel d'espace (le 0 final du tableau data)
        HAL_I2C_Mem_Write(&hi2c1, OLED_ADDR, 0x40, 1, data, 6, 10);
    }
}

void ICM_Init(void) {
    uint8_t data;
    // 1. Reset du capteur
    data = 0x80;
    HAL_I2C_Mem_Write(&hi2c1, ICM_ADDR, 0x06, 1, &data, 1, 100);
    HAL_Delay(100);

    // 2. Réveil et choix de l'horloge auto
    data = 0x01;
    HAL_I2C_Mem_Write(&hi2c1, ICM_ADDR, 0x06, 1, &data, 1, 100);

    // 3. Passer en banque 0 (pour être sûr)
    data = 0x00;
    HAL_I2C_Mem_Write(&hi2c1, ICM_ADDR, 0x7F, 1, &data, 1, 100);
}

void ICM_ReadAngles(void) {
    // 1. Initialiser le tableau à zéro pour éviter les valeurs aléatoires
    uint8_t raw_data[12] = {0};
    int16_t ax, ay, az, gz;

    // 2. Vérifier que la lecture a bien fonctionné (HAL_OK)
    if (HAL_I2C_Mem_Read(&hi2c1, ICM_ADDR, 0x2D, 1, raw_data, 12, 100) == HAL_OK) {

        ax = (int16_t)(raw_data[0] << 8 | raw_data[1]);
        ay = (int16_t)(raw_data[2] << 8 | raw_data[3]);
        az = (int16_t)(raw_data[4] << 8 | raw_data[5]);
        gz = (int16_t)(raw_data[10] << 8 | raw_data[11]);

        // --- CALCUL ROULIS ET TANGAGE ---
        roll = atan2f((float)ay, (float)az) * 57.295f;
        pitch = atan2f(-(float)ax, sqrtf((float)ay * ay + (float)az * az)) * 57.295f;

        // --- CALCUL LACET (Intégration) ---
        float gz_deg = (float)gz / 131.0f;
        if (fabs(gz_deg) > 0.5f) { // Ignorer le bruit à l'arrêt
            yaw += gz_deg * 0.2f; // <-- 0.2f car tu as mis HAL_Delay(200) dans ton main !
        }
    } else {
        // Si le capteur ne répond pas, on force les valeurs à 0 pour s'en rendre compte
        roll = 0.0f;
        pitch = 0.0f;
        yaw = 0.0f;
    }
}
