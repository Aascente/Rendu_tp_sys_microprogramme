/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();
  MX_I2C1_Init();
  MX_SPI1_Init();
  MX_FATFS_Init();
  MX_TIM1_Init();
  /* USER CODE BEGIN 2 */
  OLED_Init();
    OLED_Clear();
    ICM_Init();

    uint8_t calib[24];

    // On lit les 24 octets de calibration d'un seul coup (de 0x88 à 0x9F)
    HAL_I2C_Mem_Read(&hi2c1, BMP280_ADDR, 0x88, 1, calib, 24, HAL_MAX_DELAY);

    // --- Température ---
    bmp280_calib.dig_T1 = (uint16_t)((calib[1] << 8) | calib[0]);
    bmp280_calib.dig_T2 = (int16_t)((calib[3] << 8) | calib[2]);
    bmp280_calib.dig_T3 = (int16_t)((calib[5] << 8) | calib[4]);

    // --- Pression ---
    bmp280_calib.dig_P1 = (uint16_t)((calib[7] << 8) | calib[6]);
    bmp280_calib.dig_P2 = (int16_t)((calib[9] << 8) | calib[8]);
    bmp280_calib.dig_P3 = (int16_t)((calib[11] << 8) | calib[10]);
    bmp280_calib.dig_P4 = (int16_t)((calib[13] << 8) | calib[12]);
    bmp280_calib.dig_P5 = (int16_t)((calib[15] << 8) | calib[14]);
    bmp280_calib.dig_P6 = (int16_t)((calib[17] << 8) | calib[16]);
    bmp280_calib.dig_P7 = (int16_t)((calib[19] << 8) | calib[18]);
    bmp280_calib.dig_P8 = (int16_t)((calib[21] << 8) | calib[20]);
    bmp280_calib.dig_P9 = (int16_t)((calib[23] << 8) | calib[22]);

    // --- Configuration du capteur (Registre 0xF4) ---
    // 0x27 = Mode Normal, Temp x1, Press x1
    uint8_t config = 0x27;
    HAL_I2C_Mem_Write(&hi2c1, BMP280_ADDR, 0xF4, 1, &config, 1, HAL_MAX_DELAY);

    // --- INITIALISATION DE LA CARTE SD ---
        OLED_SetCursor(0, 0);
        OLED_WriteStr("INIT SD CARD... ");

        HAL_Delay(500);

        // Montage du système de fichiers
            fres = f_mount(&fs, "", 1);
            if (fres == FR_OK) {
                OLED_SetCursor(0, 2);
                OLED_WriteStr("SD MOUNT OK!  ");

                // --- CHANGER FA_OPEN_ALWAYS PAR FA_CREATE_ALWAYS POUR REMETTRE À ZÉRO ---
                fres = f_open(&fil, "data.csv", FA_CREATE_ALWAYS | FA_WRITE);
                if(fres == FR_OK) {
                    // Le fichier étant obligatoirement vide ici, on réécrit l'en-tête proprement
                    f_puts("Temp(C),Press(hPa),Roll,Pitch,Yaw\n", &fil);
                    f_close(&fil); // On ferme pour valider la remise à zéro et l'en-tête
                }
            } else {
                OLED_SetCursor(0, 2);
                OLED_WriteStr("SD MOUNT ERR! ");
            }

        HAL_Delay(2000);
        OLED_Clear();
        // Démarrage du signal PWM pour le servomoteur sur le Channel 1 (PA8)
          HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
      float t = BMP280_ReadTemperature();
      float p = BMP280_ReadPressure();
      ICM_ReadAngles();

      // --- ASSERVISSEMENT DU SERVOMOTEUR ---
            float safe_roll = roll;
            if (safe_roll > 90.0f) safe_roll = 90.0f;
            if (safe_roll < -90.0f) safe_roll = -90.0f;

            uint32_t servo_pulse = (uint32_t)(1500.0f + (safe_roll * (500.0f / 90.0f)));

            // Envoi de la commande sur le Channel 1 (Broche PA8)
            __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, servo_pulse);

      // --- Affichage OLED ---
      OLED_SetCursor(0, 0);
      sprintf(msg, "T:%.1fC P:%.0f", t, p);
      OLED_WriteStr(msg);

      OLED_SetCursor(0, 2);
      sprintf(msg, "ROLL : %.1f   ", roll);
      OLED_WriteStr(msg);

      OLED_SetCursor(0, 4);
      sprintf(msg, "PITCH: %.1f   ", pitch);
      OLED_WriteStr(msg);

      OLED_SetCursor(0, 6);
      sprintf(msg, "YAW  : %.1f   ", yaw);
      OLED_WriteStr(msg);

      // --- ENREGISTREMENT SUR LA CARTE SD ---
            fres = f_open(&fil, "data.csv", FA_OPEN_ALWAYS | FA_WRITE);

            if (fres == FR_OK) {
                f_lseek(&fil, f_size(&fil)); // On se place à la fin du fichier

                // 1. On fabrique notre ligne de texte avec sprintf (qui comprend les floats)
                // Tu as déjà la variable 'msg' déclarée en haut de ton code, on l'utilise !
                sprintf(msg, "%.2f,%.2f,%.2f,%.2f,%.2f\n", t, p, roll, pitch, yaw);

                // 2. On écrit ce texte tout prêt sur la carte SD
                f_puts(msg, &fil);

                f_close(&fil);

                OLED_SetCursor(0, 7);
                OLED_WriteStr("SD REC: OK     ");
            } else {
                OLED_SetCursor(0, 7);
                sprintf(msg, "SD ERR: %d      ", fres);
                OLED_WriteStr(msg);
            }

      HAL_Delay(200);
  }
  /* USER CODE END 3 */
}

